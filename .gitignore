# STR — never commit secrets
**/.env
**/.env.*
*.key
*.pem
**/credentials*
**/*api_key*
**/*token*

# Local quickshell state / runtime caches
hypr/scripts/quickshell/local/
**/qs_workspaces.json
**/qs_widget_state
**/qs_current_widget
.cache/

# pywal runtime-generated files
btop/themes/wal-active.theme
# Live palette: rewritten by toggle-theme.sh and the wallpaper daemon.
# The tracked source is MatugenColors-str.qml; install.sh seeds this file from it.
hypr/scripts/quickshell/MatugenColors.qml

# Local config backups
*.bak
*.bak-*

# Brave regenerates this from manifest.json on load
brave/STR-theme/Cached Theme.pak
